            def PhysicsFixedJoint "PhysicsFixedJoint"
            {
                custom rel physics:body0
                prepend rel physics:body0 = </right_shadow_hand>
                custom rel physics:body1
                prepend rel physics:body1 = </right_shadow_hand/Geometry/rh_forearm>
                # Disabled: this joint's body0 is /right_shadow_hand, an Xform rather than a
                # rigid body. UsdPhysics anchors to the world only when body0 is EMPTY, so this
                # welds the forearm to nothing and PhysX reports fixed_base=False. Replaced by
                # rootJoint below, which leaves body0 empty. MEASURED: the spawner's
                # fix_root_link flag does NOT substitute -- it leaves fixed_base False here.
                bool physics:jointEnabled = 0
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (6.123234e-17, 0.70710677, 4.5986944e-17, 0.70710677)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
