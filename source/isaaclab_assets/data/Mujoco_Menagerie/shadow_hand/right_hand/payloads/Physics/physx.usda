                                        float physxJoint:armature = 0.0002
                                        float physxJoint:jointFriction = 0.01
                                        # PhysX multiplies an authored revolute gearing by
                                        # radians-to-degrees when it builds the tendon, so
                                        # pi/180 makes the tendon length q_J1 + q_J2 in
                                        # radians -- the same quantity MjcTendon computes
                                        # with coef [1, 1]. That equality is what lets one
                                        # command mean the same thing on both engines.
                                        float[] physxTendon:rh_FFJ0:gearing = [0.017453292]
                                    }
